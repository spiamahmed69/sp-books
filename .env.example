# SP Books — copy to .env and fill with YOUR OWN Firebase project values.
# NEVER commit real keys. Demo Mode runs when VITE_FIREBASE_API_KEY is empty.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
VITE_DEMO_MODE=true
# ImgBB key lives ONLY as a Vercel env var (IMGBB_API_KEY, server-side for
# api/upload.js) — never in this file, never in code, never committed.
# Real mode: set VITE_DEMO_MODE=false (see DEPLOYMENT.md).
